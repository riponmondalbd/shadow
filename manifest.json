{
  "manifest_version": 3,
  "name": "MyShadow - Standalone Secure Vault",
  "version": "2.0.0",
  "description": "100% Standalone Zero-Knowledge Personal Vault with AES-256-GCM encryption, In-Page Autofill, and Auto-Backup.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "alarms", "activeTab", "scripting"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "MyShadow Vault"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["selector.html", "icon48.png", "icon128.png", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
